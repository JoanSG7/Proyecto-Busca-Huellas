# ============================================================
# Busca Huellas - Archivo de ejemplo de variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# ============================================================

# ------------------------------------------------------------
# Aplicación Flask
# ------------------------------------------------------------
SECRET_KEY=busca-huellas-dev-secret-change-me

# Puerto en el que arranca Flask. Default recomendado 5000.
# Si en el PC del SENA el puerto 5000 está ocupado, cambiar aquí
# a 5001, 8000 o 8080 (puertos casi siempre libres).
PORT=5000

# En qué "dirección" escucha Flask.
#   localhost  → solo se abre en ESTE PC (sólo tú lo ves, normal en SENA)
#   0.0.0.0    → se abre en TODA la red local (otros PCs del salón
#                entran con tu IP, úsalo sólo en sustentación si quieren
#                probarlo desde más de un equipo)
# Valor por defecto (y recomendado en el día a día): localhost
FLASK_HOST=localhost

# Nombre de servidor/URL pública (OPCIONAL, dejar comentado en 99% de casos).
# Solo rellenar si publicas el proyecto en un dominio (ej: buscahuellas.co).
# Si lo dejas comentado funciona con localhost, tu IP privada, etc.
# SERVER_NAME=localhost:5000
# PREFERRED_URL_SCHEME=http

# ------------------------------------------------------------
# Base de datos MySQL / MariaDB
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=busca_huellas

# ------------------------------------------------------------
# Registro de administrador
# Código que debe ingresar quien se registre como administrador
# ------------------------------------------------------------
ADMIN_REGISTRATION_CODE=BUSCAHUELLAS-ADMIN

# ------------------------------------------------------------
# Correo SMTP (opcional, para recuperación y verificación)
# Si SMTP_HOST queda vacío los códigos se imprimen por consola.
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@buscahuellas.local

# ------------------------------------------------------------
# OAuth Google (opcional, para iniciar sesión con Google)
# Crear credenciales en: https://console.cloud.google.com/
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
